# Copy to .env.local (never committed) and fill in. On Vercel, add the same names under Project → Settings → Environment Variables.

# Resend API key from resend.com → API Keys. Emails every form submission.
RESEND_API_KEY=

# Inbox that receives leads. Several addresses: separate with commas.
LEAD_TO_EMAIL=

# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev), which can only
# deliver to the email address you signed up to Resend with. After verifying your domain in
# Resend, set e.g.: SyntecHire Website <leads@yourdomain.com>
LEAD_FROM_EMAIL=

# Zoho CRM (optional). Every enquiry is created as a Lead; a lead with the same email is updated, not duplicated.
# Create a "Self Client" at api-console.zoho.in (or .com / .eu), generate a code with scope
# ZohoCRM.modules.leads.ALL, then exchange it for a refresh token (see PLAN.md, "Zoho CRM").
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data centre of your CRM: "in" for crm.zoho.in, "com" for crm.zoho.com, "eu" for crm.zoho.eu
ZOHO_DC=in
